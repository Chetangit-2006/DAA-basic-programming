#include <stdio.h>
#define MAX 20

int graph[MAX][MAX];
int visited[MAX];
int n;

// DFS function
void DFS(int post) {
    visited[post] = 1;
    printf("Post %d ", post);

    // Visit all connected posts
    for (int i = 0; i < n; i++) {
        if (graph[post][i] == 1 && visited[i] == 0) {
            DFS(i);
        }
    }
}
int main() {
    int edges, u, v, start;

    printf("Enter number of posts: ");
    scanf("%d", &n);

    // Initialize graph
    for (int i = 0; i < n; i++) {
        visited[i] = 0;
        for (int j = 0; j < n; j++) {
            graph[i][j] = 0;
        }
    }
    printf("Enter number of connections: ");
    scanf("%d", &edges);
    printf("Enter connections (post1 post2):\n");
    for (int i = 0; i < edges; i++) {
        scanf("%d %d", &u, &v);
        graph[u][v] = 1;
        graph[v][u] = 1;   // Undirected graph
    }
    printf("Enter starting post: ");
    scanf("%d", &start);
    printf("\nPosts reached using DFS:\n");
    DFS(start);

    return 0;
}
