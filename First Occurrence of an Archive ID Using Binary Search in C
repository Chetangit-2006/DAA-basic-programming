
#include <stdio.h>

// finding first occurrence of Archive ID
int findFirstOccurrence(int arr[], int n, int target) {
    int l = 0, h = n - 1;
    int ans = -1;
    int mid;

    while (l <= h) {
        mid = (l + h) / 2;

        if (target == arr[mid]) {
            ans = mid;
            h = mid - 1;
        }
        else if (target > arr[mid]) {
            l = mid + 1;
        }
        else {
            h = mid - 1;
        }
    }

    return ans;
}

int main() {
    int n, target;

    printf("scrolls: ");
    scanf("%d", &n);

    int archive[n];

    printf("sorted Archive IDs:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &archive[i]);
    }

    printf("Archive ID: ");
    scanf("%d", &target);

    int index = findFirstOccurrence(archive, n, target);

    if (index != -1) {
        printf("Scroll found at position: %d\n", index);
    } else {
        printf("Scroll not found\n");
    }

    return 0;
