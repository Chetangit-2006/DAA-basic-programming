
#include <stdio.h>
#include <limits.h>

#define MAX 15

int n;
int cost[MAX][MAX];
int dp[1 << MAX][MAX];

// Function to find minimum TSP tour cost
int tsp(int mask, int pos)
{
    // If all cities are visited, return cost to starting city
    if (mask == (1 << n) - 1)
        return cost[pos][0];

    // Return already calculated result
    if (dp[mask][pos] != -1)
        return dp[mask][pos];

    int ans = INT_MAX;

    // Try visiting every unvisited city
    for (int city = 0; city < n; city++)
    {
        if ((mask & (1 << city)) == 0)
        {
            int newAns = cost[pos][city] +
                         tsp(mask | (1 << city), city);

            if (newAns < ans)
                ans = newAns;
        }
    }

    // Store result in DP table
    return dp[mask][pos] = ans;
}

int main()
{
    // Input number of cities
    scanf("%d", &n);

    // Input cost matrix
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);
        }
    }

    // Initialize DP table with -1
    for (int i = 0; i < (1 << n); i++)
    {
        for (int j = 0; j < n; j++)
        {
            dp[i][j] = -1;
        }
    }

    // Start from city 0
    printf("%d\n", tsp(1, 0));

    return 0;
}
